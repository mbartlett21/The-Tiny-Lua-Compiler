local tlc = require'the-tiny-lua-compiler'

local type Prototype = tlc.CodeGenerator.Prototype
-- local type Instr = tlc.CodeGenerator.Instr --{string,integer,integer,integer}

--[[
    ============================================================================
                                      (/^▽^)/
                                THE VIRTUAL MACHINE!
    ============================================================================

    Welcome to the final stage of the pipeline!

    The Virtual Machine (VM) is the engine that actually "runs" your code. While
    the Compiler translates source text into a structure the computer can understand
    (the Function Prototype), the VM is the component that interprets that structure
    and performs the actions it describes.

    This VM implements Lua 5.1's register-based architecture. Unlike stack-based
    VMs (like the JVM) where operands are pushed and popped, Lua instructions
    refer directly to specific slots (registers) in a stack array. This approach
    maps efficiently to modern CPU architectures and reduces the total instruction
    count.

    Our VM executes a "Prototype" (proto) object generated by the Code Generator,
    which holds the bytecode instructions, constants, and upvalues. To keep the focus
    on logic rather than file formats, we execute the Lua table representation
    of the prototype directly instead of parsing binary `.luac` files. This
    avoids complex bitwise manipulation and lets us focus entirely on how the
    instructions work.

--

    This has been extended from the original to allow it to run fully virtually
    with a reimplementation of Lua's standard library, rather than making it
    reuse the same environment
--]]

--* Constants *--
-- local unpack = table.unpack
local USE_CURRENT_TOP = 0

--* VirtualMachine *--
local record VirtualMachine
  __index: VirtualMachine

  new: function(): VirtualMachine

  interface Config
    FIELDS_PER_FLUSH: integer
  end
  _CONFIG: Config

  setClosure: function(self, closure: VirtualMachine.Closure): VirtualMachine.Closure
  executeClosure: function(self, params: table.PackTable<LuaValue>): table.PackTable<LuaValue>
  execute: function(self, proto: Prototype, args ?: table.PackTable<LuaValue>): table.PackTable<LuaValue>

  simple_gettable: function(self, tbl: LuaValue, k: LuaValue): LuaValue
  simple_settable: function(self, tbl: LuaValue, k: LuaValue, v: LuaValue)
  simple_add: function(self, a: LuaValue, b: LuaValue): LuaValue
  simple_sub: function(self, a: LuaValue, b: LuaValue): LuaValue
  simple_div: function(self, a: LuaValue, b: LuaValue): LuaValue
  simple_mul: function(self, a: LuaValue, b: LuaValue): LuaValue
  simple_mod: function(self, a: LuaValue, b: LuaValue): LuaValue
  simple_pow: function(self, a: LuaValue, b: LuaValue): LuaValue
  simple_unm: function(self, a: LuaValue): LuaValue
  simple_len: function(self, a: LuaValue): integer
  simple_concat: function(self, a: LuaValue, b: LuaValue): LuaValue
  simple_eq: function(self, a: LuaValue, b: LuaValue): boolean
  simple_lt: function(self, a: LuaValue, b: LuaValue): LuaValue
  simple_le: function(self, a: LuaValue, b: LuaValue): LuaValue
  simple_call: function(self, a: LuaValue, b: table.PackTable<LuaValue>): table.PackTable<LuaValue>

  simple_luaL_getmetafield: function(self, a: LuaValue, field: string): LuaValue

  simple_newtable: function(self): LuaTable
  simple_newuserdata: function(self): LuaUdata
  lua_error: function(self, err: any)
  -- simple_newclosure: function(self, run: ExtFnType, values: table.PackTable<LuaValue>): LuaExtFunc
  simple_loadbuffer: function(self, code: string, name: string): LuaVmFunc
  -- simple_newfunction: function(self, run: ExtFnType): LuaExtFunc

  -- simple_rawget: function(self, tbl: LuaValue, k: LuaValue): LuaValue
  -- simple_rawset: function(self, tbl: LuaValue, k: LuaValue, v: LuaValue)

  simple_setmetatable: function(self, v: LuaValue, tbl: LuaTable)
  simple_getmetatable: function(self, v: LuaValue): LuaTable
  -- lua_setfenv: function(self, fn: LuaVmFunc, env: LuaTable)
  -- lua_getfenv: function(self, fn: LuaVmFunc): LuaTable

  -- lua_tolstring: function(self, v: LuaValue): string
  -- lua_tonumber: function(self, v: LuaValue): number
  -- lua_touserdata: function(self, v: LuaValue): LuaUdata

  -- lua_newthread: function(self): VirtualMachine

  -- lua_pcall: function(self, fn: LuaValue, args: table.PackTable<LuaValue>, err ?: LuaValue): boolean, table.PackTable<LuaValue>

  -- lua_concat: function(self, args: table.PackTable<LuaValue>): LuaValue

  simple_luaL_newmetatable: function(self, key: string): LuaTable
  simple_luaL_setmetatable: function(self, ud: LuaValue, key: string)
  -- lua_load: function(self, )

  -- todo methods:
  -- lua_tothread: function(self, v: LuaValue): LuaThread
  -- lua_yield: function(self, values: table.PackTable<LuaValue>): table.PackTable<LuaValue>
  -- lua_resume: function(self, coro: LuaThread, args: table.PackTable<LuaValue>): table.PackTable<LuaValue>
  -- lua_status: function(self, coro: LuaThread): integer

  internal_tailcall: function(self, a: LuaValue, b: table.PackTable<LuaValue>): table.PackTable<LuaValue>

  interface UpValue
    stack: {LuaValue}
    index: integer
  end

  interface Closure
    nupvalues: integer
    env: LuaTable
    proto: Prototype
    upvalues: {UpValue}
  end

  is_table: function(any): boolean
  is_udata: function(any): boolean
  is_extfunc: function(any): boolean
  is_extfuncsimple: function(any): boolean
  is_vmfunc: function(any): boolean

  enum LuaTableKind 'Table' end
  interface LuaTable
    where VirtualMachine.is_table(self) -- self.kind == 'Table'
    kind: LuaTableKind

    values: {LuaValue:LuaValue}
    metatable: LuaTable
  end

  enum LuaUdataKind 'Udata' end
  interface LuaUdata
    where VirtualMachine.is_udata(self) -- self.kind == 'Udata'
    kind: LuaUdataKind

    data: any
    value: LuaValue
    metatable: LuaTable
  end

  type ExtFnType = function(VirtualMachine): integer

  type SimpleExtFnType = function(VirtualMachine, table.PackTable<LuaValue>): table.PackTable<LuaValue>

  enum LuaExtFuncKind 'ExtFunc' end
  interface LuaExtFunc
    where VirtualMachine.is_extfunc(self) -- self.kind == 'ExtFunc'
    kind: LuaExtFuncKind

    run: ExtFnType
  end

  enum LuaExtFuncSimpleKind 'ExtFuncSimple' end
  interface LuaExtFuncSimple
    where VirtualMachine.is_extfuncsimple(self) -- self.kind == 'ExtFuncSimple'
    kind: LuaExtFuncSimpleKind

    run: SimpleExtFnType
  end

  enum LuaVmFuncKind 'VmFunc' end
  interface LuaVmFunc
    where VirtualMachine.is_vmfunc(self) -- self.kind == 'VmFunc'
    kind: LuaVmFuncKind

    closure: Closure
  end

  type LuaValue = string | number | boolean | LuaTable | LuaExtFunc | LuaExtFuncSimple | LuaVmFunc | LuaUdata

  interface GlobalSetup
    metatables: {string:LuaTable}
    packages: LuaTable
    registry: LuaTable
    _G: LuaTable
  end

  -- instance fields
  globalSetup: GlobalSetup
  closure: Closure
end

local type LuaExtFunc = VirtualMachine.LuaExtFunc
local type LuaExtFuncSimple = VirtualMachine.LuaExtFuncSimple
local type LuaVmFunc = VirtualMachine.LuaVmFunc
local type LuaTable = VirtualMachine.LuaTable
local type LuaValue = VirtualMachine.LuaValue
local type LuaUdata = VirtualMachine.LuaUdata

local type UpValue = VirtualMachine.UpValue
local type Closure = VirtualMachine.Closure

VirtualMachine.__index = VirtualMachine -- Set up for method calls via `.`.

VirtualMachine._CONFIG = {
  -- Number of list items to accumulate before a SETLIST instruction.
  FIELDS_PER_FLUSH = 50
}


function VirtualMachine.is_table(v: any): boolean
  if v is table then
    return v.kind == 'Table'
  end
  return false
end

function VirtualMachine.is_udata(v: any): boolean
  if v is table then
    return v.kind == 'Udata'
  end
  return false
end

function VirtualMachine.is_extfunc(v: any): boolean
  if v is table then
    return v.kind == 'ExtFunc'
  end
  return false
end

function VirtualMachine.is_extfuncsimple(v: any): boolean
  if v is table then
    return v.kind == 'ExtFuncSimple'
  end
  return false
end

function VirtualMachine.is_vmfunc(v: any): boolean
  if v is table then
    return v.kind == 'VmFunc'
  end
  return false
end


--// VirtualMachine Constructor //--
function VirtualMachine.new(): VirtualMachine
  local self: VirtualMachine = setmetatable({}, VirtualMachine as metatable<VirtualMachine>)

  self.closure   = nil   -- Current closure we're working with.
  self.globalSetup = {
    metatables = {},
    packages = self:simple_newtable(),
    registry = self:simple_newtable(),
    _G = self:simple_newtable(),
  }

  return self
end

-- --// Auxiliary functions //--
-- function VirtualMachine:getLength(...: any): integer
--   return select("#", ...)
-- end

-- local function pack(...)
--   return select("#", ...), { ... }
-- end

function VirtualMachine:setClosure(closure: Closure): Closure
  closure = {
    nupvalues = closure.nupvalues or 0,
    env       = closure.env or self.globalSetup._G,
    proto     = closure.proto,
    upvalues  = closure.upvalues or {},
  }
  self.closure = closure

  return closure
end

function VirtualMachine:simple_getmetatable(tbl: LuaValue): LuaTable
  -- print(tbl, type(tbl), self.globalSetup.metatables[type(tbl)])
  if tbl is LuaTable then
    return tbl.metatable
  elseif tbl is LuaUdata then
    return tbl.metatable
  else
    return self.globalSetup.metatables[type(tbl)]
  end
end

function VirtualMachine:simple_setmetatable(tbl: LuaValue, meta: LuaTable)
  if tbl is LuaTable then
    tbl.metatable = meta
  elseif tbl is LuaUdata then
    tbl.metatable = meta
  else
    self.globalSetup.metatables[type(tbl)] = meta
  end
end

function VirtualMachine:simple_luaL_getmetafield(tbl: LuaValue, k: string): LuaValue
  local meta = self:simple_getmetatable(tbl)
  if meta then
    return meta.values[k]
  end
end

function VirtualMachine:simple_luaL_newmetatable(name: string): LuaTable
  local tbl = self:simple_newtable()
  self.globalSetup.registry.values[name] = tbl
  return tbl
end

function VirtualMachine:simple_luaL_setmetatable(ud: LuaValue, name: string)
  local tbl = assert(self.globalSetup.registry.values[name]) as LuaTable
  return self:simple_setmetatable(ud, tbl)
end

function VirtualMachine:simple_gettable(tbl: LuaValue, k: LuaValue): LuaValue
  local istbl = false
  if tbl is LuaTable then
    local v = tbl.values[k]
    istbl = true
    if v ~= nil then
      return v
    end
  end
  local metaidx = self:simple_luaL_getmetafield(tbl, "__index")
  if metaidx then
    if metaidx is LuaVmFunc or metaidx is LuaExtFunc then
      local res = self:simple_call(metaidx, { n = 2, tbl, k })
      return res[1]
    else
      return self:simple_gettable(metaidx, k)
    end
  end
  if not istbl then
    self:lua_error("attempt to index a non-table value: " .. tostring(tbl) .. ' with key ' .. tostring(k))
  end
end

function VirtualMachine:simple_settable(tbl: LuaValue, k: LuaValue, v: LuaValue)
  local istbl = false
  if tbl is LuaTable then
    istbl = true
    local vold = tbl.values[k]
    if vold == nil then
      tbl.values[k] = v
      return
    end
  end
  local metaidx = self:simple_luaL_getmetafield(tbl, "__newindex")
  if metaidx then
    self:simple_call(metaidx, { n = 2, tbl, k })
  elseif istbl then
    (tbl as LuaTable).values[k] = v
  else
    self:lua_error("attempt to set-index a non-table value: " .. tostring(tbl)
      .. ' with key ' .. tostring(k)
      .. ' and value ' .. tostring(v))
  end
end

function VirtualMachine:simple_add(a: LuaValue, b: LuaValue): LuaValue
  if a is number and b is number then
    return a + b
  else
    local meta = self:simple_luaL_getmetafield(a, "__add") or self:simple_luaL_getmetafield(b, "__add")
    if not meta then
      self:lua_error("attempt to add invalid values")
    end
    local res = self:simple_call(meta, { n = 2, a, b })
    return res[1]
  end
end

function VirtualMachine:simple_sub(a: LuaValue, b: LuaValue): LuaValue
  if a is number and b is number then
    return a - b
  else
    local meta = self:simple_luaL_getmetafield(a, "__sub") or self:simple_luaL_getmetafield(b, "__sub")
    if not meta then
      self:lua_error("attempt to subtract invalid values")
    end
    local res = self:simple_call(meta, { n = 2, a, b })
    return res[1]
  end
end

function VirtualMachine:simple_div(a: LuaValue, b: LuaValue): LuaValue
  if a is number and b is number then
    return a / b
  else
    local meta = self:simple_luaL_getmetafield(a, "__div") or self:simple_luaL_getmetafield(b, "__div")
    if not meta then
      self:lua_error("attempt to divide invalid values")
    end
    local res = self:simple_call(meta, { n = 2, a, b })
    return res[1]
  end
end

function VirtualMachine:simple_mul(a: LuaValue, b: LuaValue): LuaValue
  if a is number and b is number then
    return a * b
  else
    local meta = self:simple_luaL_getmetafield(a, "__mul") or self:simple_luaL_getmetafield(b, "__mul")
    if not meta then
      self:lua_error("attempt to mul invalid values")
    end
    local res = self:simple_call(meta, { n = 2, a, b })
    return res[1]
  end
end

function VirtualMachine:simple_mod(a: LuaValue, b: LuaValue): LuaValue
  if a is number and b is number then
    return a % b
  else
    local meta = self:simple_luaL_getmetafield(a, "__mod") or self:simple_luaL_getmetafield(b, "__mod")
    if not meta then
      self:lua_error("attempt to mod invalid values")
    end
    local res = self:simple_call(meta, { n = 2, a, b })
    return res[1]
  end
end

function VirtualMachine:simple_pow(a: LuaValue, b: LuaValue): LuaValue
  if a is number and b is number then
    return a ^ b
  else
    local meta = self:simple_luaL_getmetafield(a, "__pow") or self:simple_luaL_getmetafield(b, "__pow")
    if not meta then
      self:lua_error("attempt to pow invalid values")
    end
    local res = self:simple_call(meta, { n = 2, a, b })
    return res[1]
  end
end

function VirtualMachine:simple_unm(a: LuaValue): LuaValue
  if a is number then
    return -a
  else
    local meta = self:simple_luaL_getmetafield(a, "__unm")
    if not meta then
      self:lua_error("attempt to unm invalid value")
    end
    local res = self:simple_call(meta, { n = 2, a, a })
    return res[1]
  end
end

function VirtualMachine:simple_len(a: LuaValue): integer
  if a is string then
    return #a
  end
  local meta = self:simple_luaL_getmetafield(a, "__len")
  if meta then
    return math.tointeger(tostring(self:simple_call(meta, { n = 2, a, a })[1]))
  elseif a is LuaTable then
    return #(a.values as {any})
  else
    self:lua_error("attempt to get length of invalid value")
  end
end

function VirtualMachine:simple_concat(a: LuaValue, b: LuaValue): LuaValue
  if (a is string or a is number) and (b is string or b is number) then
    return (a as string) .. (b as string)
  else
    local meta = self:simple_luaL_getmetafield(a, "__concat") or self:simple_luaL_getmetafield(b, "__concat")
    if not meta then
      self:lua_error("attempt to concat invalid values")
    end
    local res = self:simple_call(meta, { n = 2, a, b })
    return res[1]
  end
end

function VirtualMachine:simple_eq(a: LuaValue, b: LuaValue): boolean
  if a == b then return true end
  if a is LuaTable and b is LuaTable then
    local meta = self:simple_luaL_getmetafield(a, "__eq") or self:simple_luaL_getmetafield(b, "__eq")
    if not meta then
      return false
    end
    local res = self:simple_call(meta, { n = 2, a, b })
    return not not res[1]
  elseif a is LuaUdata and b is LuaUdata then
    local meta = self:simple_luaL_getmetafield(a, "__eq") or self:simple_luaL_getmetafield(b, "__eq")
    if not meta then
      return false
    end
    local res = self:simple_call(meta, { n = 2, a, b })
    return not not res[1]
  else
    return false
  end
end

function VirtualMachine:simple_lt(a: LuaValue, b: LuaValue): LuaValue
  if a is string and b is string then
    return a < b
  elseif a is number and b is number then
    return a < b
  else
    local meta = self:simple_luaL_getmetafield(a, "__lt") or self:simple_luaL_getmetafield(b, "__lt")
    if not meta then
      self:lua_error("attempt to lt invalid values")
    end
    local res = self:simple_call(meta, { n = 2, a, b })
    return not not res[1]
  end
end

function VirtualMachine:simple_le(a: LuaValue, b: LuaValue): LuaValue
  if a is string and b is string then
    return a <= b
  elseif a is number and b is number then
    return a <= b
  else
    local meta = self:simple_luaL_getmetafield(a, "__le") or self:simple_luaL_getmetafield(b, "__le")
    if not meta then
      return not self:simple_lt(b, a)
    end
    local res = self:simple_call(meta, { n = 2, a, b })
    return not not res[1]
  end
end

function VirtualMachine:simple_call(a: LuaValue, b: table.PackTable<LuaValue>): table.PackTable<LuaValue>
  if a is LuaVmFunc then
    -- can be simply executed.
    local currclosure = self.closure
    self:setClosure(a.closure)
    local rets = self:executeClosure(b)
    self:setClosure(currclosure)
    return rets
  elseif a is LuaExtFuncSimple then
    return assert(a.run(self, b))
  else
    local meta = self:simple_luaL_getmetafield(a, "__call")
    if meta then
      return self:simple_call(meta, table.pack(a, table.unpack(b, 1, b.n)))
    end
    self:lua_error("attempt to call a non-function value: " .. tostring(a))
  end
end

-- we have the optimisation that it doesn't need to be set back, so it is a proper tail call
function VirtualMachine:internal_tailcall(a: LuaValue, b: table.PackTable<LuaValue>): table.PackTable<LuaValue>
  if a is LuaVmFunc then
    -- can be simply executed.
    self:setClosure(a.closure)
    return self:executeClosure(b)
  elseif a is LuaExtFuncSimple then
    return a.run(self, b)
  else
    local meta = self:simple_luaL_getmetafield(a, "__call")
    if meta then
      return self:internal_tailcall(meta, table.pack(a, table.unpack(b, 1, b.n)))
    end
    self:lua_error("attempt to tailcall a non-function value: " .. tostring(a))
  end
end

function VirtualMachine:simple_newtable(): LuaTable
  return {
    kind = 'Table',
    values = {},
  }
end

function VirtualMachine:simple_newuserdata(): LuaUdata
  return {
    kind = 'Udata',
    data = nil,
    value = nil,
  }
end

function VirtualMachine:simple_loadbuffer(buf: string, _name: string): LuaVmFunc
  local tokens    = tlc.Tokenizer.new(buf):tokenize()
  local ast       = tlc.Parser.new(tokens):parse()
  local proto     = tlc.CodeGenerator.new(ast):generate()

  local tClosure: Closure = {
    nupvalues = 0,
    env       = self.globalSetup._G,
    proto     = proto,
    upvalues  = {},
  }

  return {
    kind = 'VmFunc',
    closure = tClosure,
  }
end

function VirtualMachine:lua_error(err: any)
  -- todo: do better error handling with pcall etc.
  -- print(self.closure.proto.functionName)
  error(err, 2)
end

local function do_number(v: LuaValue): number
  if v is string then
    v = tonumber(v)
  end
  if v is number then
    return v
  end
  error("Expected number")
end

local function unpacklvalue(v: LuaValue): any
  if v is nil or v is boolean or v is number or v is string then
    return v
  elseif v is LuaVmFunc then
    error("Functions can't be unpacked")
  elseif v is LuaExtFuncSimple then
    return v.run
  elseif v is LuaExtFunc then
    return v.run
  elseif v is LuaTable then
    local newtbl = {}
    for k, v2 in pairs(v.values) do
      newtbl[unpacklvalue(k)] = unpacklvalue(v2)
    end
    return newtbl
  end
end

function VirtualMachine:unpack_tables(items: table.PackTable<LuaValue>): table.PackTable<any>
  local new: table.PackTable<any> = { n = items.n }

  for i = 1, items.n do
    new[i] = unpacklvalue(items[i])
  end

  return new
end

--// Execution //--
function VirtualMachine:executeClosure(params: table.PackTable<LuaValue>): table.PackTable<LuaValue>
  -- Optimization: localize fields.
  -- print('>>>' .. self.closure.proto.functionName)
  local closure   = self.closure
  local stack: {LuaValue}     = {}
  local env       = closure.env
  local proto     = closure.proto
  local upvalues  = closure.upvalues
  local code      = proto.code
  local constants = proto.constants
  local numparams = proto.numParams
  local isVararg  = proto.isVararg

  local maxStackSize = proto.maxStackSize
  local top = maxStackSize
  local upvalueStack: {UpValue} = {}
  local maxUpvalue = -1

  -- Gets a value from either the stack or constants table.
  -- NOTE: Constant indices are represented as negative numbers
  -- in our implementation, so in order to get the correct constant,
  -- we negate the index when accessing the constants table.
  local function rk(index: integer): LuaValue
    if index < 0 then return constants[-index] end
    return stack[index]
  end

  -- Initialize parameters.
  local vararg: table.PackTable<LuaValue>

  for paramIdx = 1, numparams do
    stack[paramIdx - 1] = params[paramIdx]
  end
  if isVararg then
    vararg = params
    stack[numparams] = { kind = 'Table', values = params as {LuaValue:LuaValue} } -- Implicit "arg" argument.
  end

  -- Prepare for execution loop.
  local pc = 1
  while true do
    local instruction = code[pc]
    if not instruction then
      break
    end

    local opcode, a, b, c: string, integer, integer, integer = instruction[1], instruction[2], instruction[3], instruction[4]

    -- NOTE:
    --  Many Lua VM implementations written in Lua use binary search on sorted
    --  opcode tables for faster dispatch, reducing lookup time from O(n) to
    --  O(log n). For clarity and maintainability, TLC uses a simple linear
    --  if-else chain instead. This makes the code easier to read and modify,
    --  prioritizing education over speed.

    -- OP_MOVE [A, B]    R(A) := R(B)
    -- Copy a value between registers.
    if opcode == "MOVE" then
      stack[a] = stack[b]

    -- OP_LOADK [A, Bx]    R(A) = Kst(Bx)
    -- Load a constant into a register.
    elseif opcode == "LOADK" then
      stack[a] = constants[-b]

    -- OP_LOADBOOL [A, B, C]    R(A) := (Bool)B; if (C) pc++
    -- Load a boolean into a register.
    elseif opcode == "LOADBOOL" then
      stack[a] = (b == 1)
      if c == 1 then
        pc = pc + 1
      end

    -- OP_LOADNIL [A, B]    R(A) := ... := R(B) := nil
    -- Load nil values into a range of registers.
    elseif opcode == "LOADNIL" then
      local reg = b
      repeat
        stack[reg] = nil
        reg = reg - 1
      until reg < a

    -- OP_GETUPVAL [A, B]    R(A) := UpValue[B]
    -- Read an upvalue into a register.
    elseif opcode == "GETUPVAL" then
      local upvalue = upvalues[b + 1]
      stack[a] = upvalue.stack[upvalue.index]

    -- OP_GETGLOBAL [A, Bx]    R(A) := Gbl[Kst(Bx)]
    -- Read a global variable into a register.
    elseif opcode == "GETGLOBAL" then
      stack[a] = self:simple_gettable(env, constants[-b])

    -- OP_GETTABLE [A, B, C]    R(A) := R(B)[RK(C)]
    -- Read a table element into a register.
    elseif opcode == "GETTABLE" then
      stack[a] = self:simple_gettable(stack[b], rk(c))

    -- OP_SETGLOBAL [A, Bx]    Gbl[Kst(Bx)] := R(A)
    -- Write a register value into a global variable.
    elseif opcode == "SETGLOBAL" then
      self:simple_settable(env, rk(b), stack[a])

    -- OP_SETUPVAL [A, B]    UpValue[B] := R(A)
    -- Write a register value into an upvalue.
    elseif opcode == "SETUPVAL" then
      local upvalue = upvalues[b + 1]
      upvalue.stack[upvalue.index] = stack[a]

    -- OP_SETTABLE [A, B, C]    R(A)[RK(B)] := RK(C)
    -- Write a register value into a table element.
    elseif opcode == "SETTABLE" then
      self:simple_settable(stack[a], rk(b), rk(c))

    -- OP_NEWTABLE [A, B, C]    R(A) := {} (size = B,C)
    -- Create a new table and store it in a register.
    -- B = array part size hint, C = hash part size hint (ignored here).
    elseif opcode == "NEWTABLE" then
      stack[a] = self:simple_newtable()

    -- OP_SELF [A, B, C]    R(A+1) := R(B); R(A) := R(B)[RK(C)]
    -- Prepare an object method for calling.
    elseif opcode == "SELF" then
      local rb = stack[b]
      stack[a + 1] = rb
      stack[a] = self:simple_gettable(rb, rk(c))

    -- OP_ADD [A, B, C]    R(A) := RK(B) + RK(C)
    -- Add two values and store the result in a register.
    elseif opcode == "ADD" then
      stack[a] = self:simple_add(rk(b), rk(c))

    -- OP_SUB [A, B, C]    R(A) := RK(B) - RK(C)
    -- Subtract two values and store the result in a register.
    elseif opcode == "SUB" then
      stack[a] = self:simple_sub(rk(b), rk(c))

    -- OP_MUL [A, B, C]    R(A) := RK(B) * RK(C)
    -- Multiply two values and store the result in a register.
    elseif opcode == "MUL" then
      stack[a] = self:simple_mul(rk(b), rk(c))

    -- OP_DIV [A, B, C]    R(A) := RK(B) / RK(C)
    -- Divide two values and store the result in a register.
    elseif opcode == "DIV" then
      stack[a] = self:simple_div(rk(b), rk(c))

    -- OP_MOD [A, B, C]    R(A) := RK(B) % RK(C)
    -- Calculate the modulus of two values and store the result in a register.
    elseif opcode == "MOD" then
      stack[a] = self:simple_mod(rk(b), rk(c))

    -- OP_POW [A, B, C]    R(A) := RK(B) ^ RK(C)
    -- Raise a value to the power of another and store the result in a register.
    elseif opcode == "POW" then
      stack[a] = self:simple_pow(rk(b), rk(c))

    -- OP_UNM [A, B]    R(A) := -R(B)
    -- Negate a value and store the result in a register.
    elseif opcode == "UNM" then
      stack[a] = self:simple_unm(stack[b])

    -- OP_NOT [A, B]    R(A) := not R(B)
    -- Logical NOT of a value and store the result in a register.
    elseif opcode == "NOT" then
      stack[a] = not stack[b]

    -- OP_LEN [A, B]    R(A) := length of R(B)
    -- Get the length of a value and store it in a register.
    elseif opcode == "LEN" then
      stack[a] = self:simple_len(stack[b])

    -- OP_CONCAT [A, B, C]    R(A) := R(B).. ... ..R(C)
    -- Concatenate a range of registers and store the result in a register.
    elseif opcode == "CONCAT" then
      for reg = c - 1, b, -1 do
        stack[reg] = self:simple_concat(stack[reg], stack[reg + 1])
      end
      stack[a] = stack[b]

    -- OP_JMP [A, sBx]    pc+=sBx
    -- Jump to a new instruction offset.
    elseif opcode == "JMP" then
      pc = pc + b

    -- OP_EQ [A, B, C]    if ((RK(B) == RK(C)) ~= A) then pc++
    -- Conditional jump based on equality.
    elseif opcode == "EQ" then
      local bv, cv = rk(b), rk(c)
      local isEqual = bv == cv or self:simple_eq(bv, cv)
      local bool = (a == 1)
      if isEqual ~= bool then
        pc = pc + 1
      end

    -- OP_LT [A, B, C]    if ((RK(B) < RK(C)) ~= A) then pc++
    -- Conditional jump based on less-than comparison.
    elseif opcode == "LT" then
      local isLessThan = self:simple_lt(rk(b), rk(c))
      local bool = (a == 1)
      if isLessThan ~= bool then
        pc = pc + 1
      end

    -- OP_LE [A, B, C]    if ((RK(B) <= RK(C)) ~= A) then pc++
    -- Conditional jump based on less-than-or-equal comparison.
    elseif opcode == "LE" then
      local isLessThanOrEqual = self:simple_le(rk(b), rk(c))
      local bool = (a == 1)
      if isLessThanOrEqual ~= bool then
        pc = pc + 1
      end

    -- OP_TEST [A, C]    if not (R(A) <=> C) then pc++
    -- Boolean test, with a conditional jump.
    -- NOTE: After this instruction, the next instruction will always be a jump.
    elseif opcode == "TEST" then
      local bool = (c == 1)
      if (not stack[a]) == bool then
        pc = pc + 1
      else
        -- Optimization:
        --  Since we know that the next instruction is guaranteed to be a jump,
        --  we can implement it here to avoid an extra iteration of the loop.
        --
        -- TODO: Should we verify that the next instruction is indeed a JMP?
        local nextInstruction = code[pc + 1]
        local jumpDistance = nextInstruction[3]
        pc = pc + 1 + jumpDistance
      end

    -- OP_TESTSET [A, B, C]    if (R(B) <=> C) then R(A) := R(B) else pc++
    -- Boolean test, with conditional assignment and jump.
    -- NOTE: After this instruction, the next instruction will always be a jump.
    elseif opcode == "TESTSET" then
      local bool = (c == 1)
      if (not stack[a]) == bool then
        stack[a] = stack[b]

        -- Optimization:
        --  Since we know that the next instruction is guaranteed to be a jump,
        --  we can implement it here to avoid an extra iteration of the loop.
        --
        -- TODO: Should we verify that the next instruction is indeed a JMP?
        local nextInstruction = code[pc + 1]
        local jumpDistance = nextInstruction[3]
        pc = pc + 1 + jumpDistance
      else
        pc = pc + 1
      end

    -- OP_CALL [A, B, C]    R(A), ... ,R(A+C-2) := R(A)(R(A+1), ... ,R(A+B-1))
    -- Call a closure (function) with arguments and handle returns.
    elseif opcode == "CALL" then
      local func = stack[a]
      if b ~= USE_CURRENT_TOP then
        top = a + b
      end

      local subParams: table.PackTable<LuaValue> = { n = top - 1 - a }
      for i = a + 1, top - 1 do
        subParams[i - a] = stack[i]
      end
      local returns = self:simple_call(func, subParams)
      -- local nReturns, returns = pack(func(unpack(stack, a + 1, top - 1)))

      if c ~= USE_CURRENT_TOP then
        returns.n = c - 1
      else
        -- Multi-return: push all results onto the stack.
        top = a + returns.n
      end
      for index = 1, returns.n do
        stack[a + index - 1] = returns[index]
      end

    -- OP_TAILCALL [A, B, C]    return R(A)(R(A+1), ... ,R(A+B-1))
    -- Perform a tail call to a closure (function).
    elseif opcode == "TAILCALL" then
      local func = stack[a]
      if b ~= USE_CURRENT_TOP then
        top = a + b
      end

      -- Continuation of original implementation:
      --   ```lua
      --   local returns = { func(unpack(args)) }
      --   local nReturns = self:getLength(unpack(returns))
      --   top = a + nReturns - 1
      --   for index = 1, nReturns do
      --     stack[a + index - 1] = returns[index]
      --   end
      --   ```
      --
      -- Optimization:
      --   Since TAILCALL always comes before RETURN,
      --   we can just return the function call results directly.
      local subParams: table.PackTable<LuaValue> = { n = top - 1 - a }
      for i = a + 1, top - 1 do
        subParams[i - a] = stack[i]
      end
      return self:internal_tailcall(func, subParams)
      -- return func(unpack(stack, a + 1, top - 1))

    -- OP_RETURN [A, B]    return R(A), ... ,R(A+B-2)
    -- Return values from function call.
    elseif opcode == "RETURN" then
      if b ~= USE_CURRENT_TOP then
        top = a + b - 1
      end

      local rett: table.PackTable<LuaValue> = { n = top - a }
      for i = a, top - 1 do
        rett[i - a + 1] = stack[i]
      end

      return rett

      -- return unpack(stack, a, top - 1)

    -- OP_FORLOOP [A, sBx]   R(A)+=R(A+2)
    --                       if R(A) <?= R(A+1) then { pc+=sBx R(A+3)=R(A) }
    -- Iterate a numeric for loop.
    elseif opcode == "FORLOOP" then
      local step  = do_number(stack[a + 2])
      local idx   = do_number(stack[a]) + step
      local limit = do_number(stack[a + 1])

      local shouldContinue = false
      if step >= 0 then
        shouldContinue = (idx <= limit)
      else
        shouldContinue = (idx >= limit)
      end

      if shouldContinue then
        pc = pc + b
        stack[a] = idx
        stack[a + 3] = idx
      end

    -- OP_FORPREP [A, sBx]    R(A)-=R(A+2) pc+=sBx
    -- Initialize a numeric for loop.
    elseif opcode == "FORPREP" then
      local init   = do_number(stack[a])
      -- local plimit = do_number(stack[a + 1])
      local pstep  = do_number(stack[a + 2])
      -- if not tonumber(init) then
      --   error("Initial value must be a number")
      -- elseif not tonumber(plimit) then
      --   error("Limit must be a number")
      -- elseif not tonumber(pstep) then
      --   error("Step must be a number")
      -- end

      stack[a] = init - pstep
      pc = pc + b

    -- OP_TFORLOOP [A, C]    R(A+3), ... ,R(A+2+C) := R(A)(R(A+1), R(A+2))
    --                       if R(A+3) ~= nil then R(A+2)=R(A+3) else pc++
    -- Iterate a generic for loop.
    -- NOTE: After this instruction, the next instruction will always be a jump.
    elseif opcode == "TFORLOOP" then
      local cb = a + 3

      -- Copy function and arguments for the call.
      stack[cb + 2] = stack[a + 2] -- The iterator function.
      stack[cb + 1] = stack[a + 1] -- The state.
      stack[cb] = stack[a]         -- The control variable.

      -- Call the iterator function.
      local iteratorFunc = stack[cb]
      local returns = self:simple_call(iteratorFunc, {
        n = 2,
        stack[cb + 1],
        stack[cb + 2],
      })

      -- Place results on the stack, starting at cb.
      -- The number of results to keep is specified by `c`.
      for i = 1, c do
        stack[cb + i - 1] = returns[i]
      end

      -- Check if the new control variable is nil.
      if stack[cb] ~= nil then
        -- If not nil, copy it to R(A+2) (the control variable).
        stack[cb - 1] = stack[cb]

        -- Optimization:
        --  Since we know that the next instruction is guaranteed to be a jump,
        --  we can implement it here to avoid an extra iteration of the loop.
        --
        -- TODO: Should we verify that the next instruction is indeed a JMP?
        local nextInstruction = code[pc + 1]
        local jumpDistance = nextInstruction[3]
        pc = pc + 1 + jumpDistance
      else
        -- Otherwise, skip the next instruction.
        -- (Should be the jump back to the loop start.)
        pc = pc + 1
      end

    -- OP_SETLIST [A, B, C]    R(A)[(C-1)*FPF+i] := R(A+i), 1 <= i <= B
    -- Set a range of array elements in a table.
    elseif opcode == "SETLIST" then
      local targetTable = stack[a]
      if targetTable is LuaTable then
        local len = b
        if len == USE_CURRENT_TOP then
          len = top - a - 1
        end

        -- If C is 0, it indicates that the next instruction
        -- contains the actual C value (not implemented here).
        if c == 0 then
          error("SETLIST with C=0 is not supported in this VM implementation")
        end

        local offset = (c - 1) * self._CONFIG.FIELDS_PER_FLUSH
        for i = 1, len do
          targetTable.values[offset + i] = stack[a + i]
        end
      else
        error("SETLIST target is not a table")
      end

    -- OP_VARARG [A]    close all variables in the stack up to (>=) R(A)
    elseif opcode == "CLOSE" then
      for i = a, maxUpvalue do
        local uv = upvalueStack[i]
        if uv then
          uv.stack = { stack[uv.index] }
          uv.index = 1
          upvalueStack[i] = nil
        end
      end
      maxUpvalue = a - 1

    -- OP_CLOSURE [A, Bx]    R(A) := closure(KPROTO[Bx], R(A), ... ,R(A+n))
    -- Create a new closure (function) and store it in a register.
    elseif opcode == "CLOSURE" then
      local tProto = proto.protos[b + 1]
      local tProtoUpvalues = {}

      -- Capture upvalues for the new closure.
      -- These are pseudo-instructions, and we need to skip
      -- over them while processing the CLOSURE instruction.
      for _ = 1, #tProto.upvalues do
        pc = pc + 1

        local pseudoInstruction = code[pc]
        local opname = pseudoInstruction[1]
        local index = pseudoInstruction[3]
        if opname == "MOVE" then
          local upvalue = upvalueStack[index] or {
            index = index,
            stack = stack,
          }
          upvalueStack[index] = upvalue
          if index > maxUpvalue then maxUpvalue = index end
          table.insert(tProtoUpvalues, upvalue)
        elseif opname == "GETUPVAL" then
          local upvalue = upvalues[index + 1]
          table.insert(tProtoUpvalues, upvalue)
        else
          error("Unexpected instruction while capturing upvalues: " .. tostring(opname))
        end
      end

      local tClosure: Closure = {
        nupvalues = #tProtoUpvalues,
        env       = nil,
        proto     = tProto,
        upvalues  = tProtoUpvalues,
      }

      -- NOTE:
      --  In a standard Lua VM, CLOSURE would allocate a proper CClosure or
      --  LClosure structure (see lvm.c, lfunc.c, lobject.h in Lua 5.1 source).
      --  These structures hold a reference to the function prototype, an array of
      --  upvalue pointers, and runtime state like the environment.
      --
      --  TLC simplifies this by wrapping the closure in a native Lua function.
      --
      --  Why this design? First, it provides seamless interoperability, allowing
      --  TLC-compiled functions to be passed to native Lua APIs like table.foreach
      --  or pcall without reimplementing the entire standard library. Second, it
      --  dramatically simplifies the implementation by avoiding the need for
      --  CallInfo frames, stack bases, and complex upvalue management with open
      --  and closed upvalue lists.
      --
      --  The trade-off is that we lose some fidelity compared to a real Lua VM.
      --  We don't have proper function identity tracking, and debug hooks are
      --  harder to implement. However, we gain a working VM in roughly 500 lines
      --  of code.
      stack[a] = {
        kind = 'VmFunc',
        closure = tClosure,
      }

    -- OP_VARARG [A, B]    R(A), R(A+1), ..., R(A+B-1) = vararg
    -- Load vararg function arguments into registers.
    elseif opcode == "VARARG" then
      if b == USE_CURRENT_TOP then
        top = a + vararg.n
        for i = 1, vararg.n do
          stack[a + i - 1] = vararg[i]
        end
      else
        for i = 1, b - 1 do
          stack[a + i - 1] = vararg[i]
        end
      end
    else
      error("Unimplemented instruction: " .. tostring(opcode))
    end

    -- Advance to the next instruction.
    pc = pc + 1
  end
end

function VirtualMachine:execute(proto: Prototype, args ?: table.PackTable<LuaValue>): table.PackTable<LuaValue>
  -- Push main closure.
  self:setClosure({
    nupvalues = 0,
    env       = self.globalSetup._G,
    proto     = proto,
    upvalues  = {},
  })

  return self:executeClosure(args or { n = 0 })
end

return VirtualMachine
